{
  "keys": {
    "PADD": "People Planning",
    "PAIX": "People AIX",
    "CDAP": "Central de Ajuda People",
    "CLEVEL": "C-Level Management"
  },
  "levels": {
    "5": { "role": "superadmin", "keys": ["PADD","PAIX","CDAP","CLEVEL"], "access": "full" },
    "4": { "role": "admin", "keys": ["PADD","PAIX","CDAP","CLEVEL"], "access": "full" },
    "3": { "role": "team_people", "keys": ["PADD","PAIX","CDAP"], "access": "read_write" },
    "2": { "role": "condo_leader", "keys": ["PADD","CDAP"], "access": "read_only" },
    "1": { "role": "condopower", "keys": ["CDAP"], "access": "read_only" }
  },
  "operations": {
    "read_only": ["searchJiraIssuesUsingJql", "getJiraIssue", "searchConfluenceUsingCql", "getConfluencePage"],
    "read_write": ["createJiraIssue", "editJiraIssue", "transitionJiraIssue", "deleteJiraIssue", "createConfluencePage", "updateConfluencePage"],
    "full": ["*"]
  },
  "deny": {
    "actions": ["deleteProject", "createProject", "updateProject", "deleteConfluenceSpace", "createConfluenceSpace"],
